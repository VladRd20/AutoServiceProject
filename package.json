{
  "name": "service-auto",
  "version": "0.8.2",
  "description": "Aplicatie de gestiune fise de service auto",
  "main": "./out/main/index.js",
  "author": "ServiceAuto",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && node scripts/fix-hoisted-deps.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --win --publish always",
    "test": "vitest run",
    "test:watch": "vitest",
    "keys:backup": "node scripts/keys-backup.js backup",
    "keys:restore": "node scripts/keys-backup.js restore",
    "lint": "eslint ."
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.8.11",
    "pdfmake": "^0.2.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "25.0.1",
    "playwright-core": "^1.63.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.serviceauto.app",
    "productName": "Service Auto",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "build/fonts",
        "to": "fonts"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "VladRd20",
      "repo": "AutoServiceProject"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    }
  },
  "allowScripts": {
    "electron@45.2.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=20.19"
  }
}
