{
  "name": "service-auto",
  "version": "0.5.1",
  "description": "Aplicatie de gestiune fise de service auto",
  "main": "./out/main/index.js",
  "author": "ServiceAuto",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fix-hoisted-deps.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "pdfmake": "^0.2.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.serviceauto.app",
    "productName": "Service Auto",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "build/fonts",
        "to": "fonts"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "VladRd20",
      "repo": "AutoServiceProject"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
